<hc:Window x:Class="ShuffleBoxTestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:ShuffleBoxTestApp.Converters"
        xmlns:views="clr-namespace:ShuffleBoxTestApp.Views"
        Title="Shuffle Box 线序测试系统 v2.0" Height="900" Width="1240"
        MinHeight="700" MinWidth="1100"
        Background="#F4F4F4" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:StatusToForegroundConverter x:Key="StatusToForeground" />
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 顶部分段导航按钮：选中态用主色填充，未选中为浅色描边 -->
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="18,7" Margin="0,0,6,0"
                                Background="Transparent" BorderBrush="#D8D8D8" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#EFEFEF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BDBDBD"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0,0,0,-5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="152.52"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶部：串口模块与全局状态 ================= -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="串口:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0"/>

                    <!-- 串口下拉：主行 = 口号 + 设备描述；副行 = 驱动服务名 / VID_PID / 健康状态 -->
                    <ComboBox Width="330" Height="32" Margin="0,0,8,0"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding Ports}"
                              SelectedItem="{Binding SelectedPort}"
                              hc:InfoElement.Placeholder="选择串口">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Display}" FontSize="12"/>
                                    <TextBlock Text="{Binding DriverSummary}" FontSize="10" Foreground="#888"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding PortName}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}" MaxWidth="380" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DriverService, StringFormat=驱动服务: {0}}"/>
                                                <TextBlock Text="{Binding Manufacturer, StringFormat=驱动提供方: {0}}"/>
                                                <TextBlock Text="{Binding DeviceId, StringFormat=设备实例: {0}}" MaxWidth="380" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Status, StringFormat=状态: {0}}"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <Button Content="↻" Width="32" Height="32" Margin="0,0,12,0"
                            ToolTip="重新扫描串口与驱动信息"
                            Command="{Binding RefreshPortsCommand}"/>

                    <TextBlock Text="波特率:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,5,0"/>
                    <ComboBox Width="95" Height="32" Margin="0,0,12,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding BaudRates}"
                              SelectedItem="{Binding SelectedBaudRate}"/>

                    <Button Content="连接设备" Style="{StaticResource ButtonPrimary}" Width="85" Height="32"
                            Margin="0,0,8,0" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}"/>
                    <Button Content="断开" Width="60" Height="32" Margin="0,0,15,0"
                            Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}"/>

                    <!-- 连接状态胶囊 -->
                    <Border Background="{Binding ConnectionText, Converter={StaticResource StatusToBrush}}"
                            CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{Binding ConnectionText, Converter={StaticResource StatusToForeground}}"/>
                            <TextBlock Text="{Binding ConnectionText}"
                                       Foreground="{Binding ConnectionText, Converter={StaticResource StatusToForeground}}"
                                       FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                        <TextBlock Text="主控板:" Foreground="#666"/>
                        <TextBlock Text="{Binding BoardDisplay}" FontWeight="Bold" Foreground="#333" Margin="4,0,18,0"/>
                        <TextBlock Text="心跳:" Foreground="#666"/>
                        <TextBlock Text="{Binding HeartbeatDisplay}" FontWeight="Bold" Foreground="#333" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 第二行：SN 录入（扫码枪以回车结尾，扫码即绑定）与配方 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SN 录入:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0"/>
                    <TextBox x:Name="SnBox" Width="220" Height="28" VerticalContentAlignment="Center"
                             hc:InfoElement.Placeholder="扫码枪扫描后自动回车提交"
                             KeyDown="SnKeyDown"/>
                    <TextBlock Text="当前 SN:" Foreground="#666" Margin="14,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ScannedSerialNumber}" FontWeight="Bold" Foreground="#333"
                               VerticalAlignment="Center" MinWidth="120"/>
                    <TextBlock Text="当前配方:" Foreground="#666" Margin="24,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentRecipe}" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 页面导航（分段切换） ================= -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="20,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource NavTabStyle}" GroupName="Nav"
                                 IsChecked="{Binding IsTestPage, Mode=OneWay}"
                                 Command="{Binding ShowLineTestCommand}"
                                 Content="📋  线序测试"/>
                    <RadioButton Style="{StaticResource NavTabStyle}" GroupName="Nav"
                                 IsChecked="{Binding IsManualPage, Mode=OneWay}"
                                 IsEnabled="{Binding CanEnterManual}"
                                 Command="{Binding ShowDeviceControlCommand}"
                                 Content="🎛  设备控制"
                                 ToolTip="手动切换光开关、采集 PD 功率，用于调试与点检"/>
                </StackPanel>

                <!-- 扫描中给出原因说明，而不是让按钮无声禁用 -->
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="#E67E22"
                           Text="扫描进行中，设备控制暂不可用"
                           Visibility="{Binding LineTest.IsScanning, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- ================= 中央工作区：线序测试页（独立文件 Views/LineTestView.xaml） ================= -->
        <!-- DataContext 指向专属 LineTestViewModel；可见性仍绑定主窗口 IsTestPage -->
        <views:LineTestView Grid.Row="2" Margin="20,20,20,20"
                            DataContext="{Binding LineTest}"
                            Visibility="{Binding DataContext.IsTestPage,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource BoolToVis}}"/>

        <!-- ================= 中央工作区：设备手动控制页 ================= -->
        <!-- DataContext 指向子视图模型，页面内部不再感知主窗口 -->
        <views:DeviceControlView Grid.Row="2" Margin="20,20,20,5"
                                 DataContext="{Binding DeviceControl}"
                                 Visibility="{Binding DataContext.IsManualPage,
                                     RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource BoolToVis}}"/>

        <!-- ================= 底部日志区（两页共用，F-RPT-02 分色 + 自动滚动） ================= -->
        <Border Grid.Row="2" Background="White" Margin="20,584,20,20" CornerRadius="8" Padding="15" Effect="{StaticResource EffectShadow2}" Grid.RowSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16*"/>
                    <ColumnDefinition Width="33*"/>
                    <ColumnDefinition Width="66*"/>
                    <ColumnDefinition Width="285*"/>
                    <ColumnDefinition Width="770*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="运行日志" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5" Grid.ColumnSpan="5"/>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}"
                         Background="#2D2D2D" BorderThickness="0" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" Grid.ColumnSpan="5" Margin="0,20,0,0" Grid.RowSpan="3">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Line}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</hc:Window>