<UserControl x:Class="ShuffleBoxTestApp.Views.DeviceControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:ShuffleBoxTestApp.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- 分区卡片标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 通道选择行的小标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 已生效通道的徽标 -->
        <Style x:Key="AppliedBadge" TargetType="Border">
            <Setter Property="Background" Value="#EEF6FF"/>
            <Setter Property="BorderBrush" Value="#CCE3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左列：光开关手动切换 ============ -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16"
                Effect="{StaticResource EffectShadow2}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="光开关手动切换" Style="{StaticResource SectionTitle}"/>

                <!-- 未连接时给出明确原因，而不是让按钮无声禁用 -->
                <Border Grid.Row="1" Background="#FFF8E6" BorderBrush="#FFE1A8" BorderThickness="1"
                        CornerRadius="4" Padding="10,6" Margin="0,0,0,12"
                        Visibility="{Binding CanOperate, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="请先在顶部连接主控板；扫描进行中本页不可操作。"
                               FontSize="11" Foreground="#B8860B" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Grid.Row="2">
                    <!-- MEMS 开关选择（mems_id 1~16，下拉框） -->
                    <TextBlock Text="MEMS 开关 (mems_id)" FontWeight="Bold" Foreground="#333" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="编号" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding MemsIds}"
                                  SelectedItem="{Binding MemsId}"/>
                    </Grid>

                    <!-- MEMS 通道输入（mems_ch 1~64，输入框避免下拉过长） -->
                    <TextBlock Text="MEMS 通道 (mems_ch)" FontWeight="Bold" Foreground="#333" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="通道" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding MemsChText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="3" Content="切换" Width="66" Height="30"
                                Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SwitchCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding MemsChRange, StringFormat=范围 {0}，回车或点击切换下发}"
                               FontSize="11" Foreground="#999" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="当前生效:" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource AppliedBadge}">
                            <TextBlock Text="{Binding AppliedMems}" FontWeight="Bold" Foreground="#1E6FD9"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 通路示意 -->
                <Border Grid.Row="4" Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1"
                        CornerRadius="4" Padding="10" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="当前光路" FontSize="11" Foreground="#999" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" Foreground="#555" TextWrapping="Wrap">
                            <Run Text="光源 → "/>
                            <Run Text="{Binding AppliedMems, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" → Shuffle Box → PD"/>
                            <Run Text="{Binding PdId, Mode=OneWay, StringFormat={}{0}}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 右列：PD 采集与回读容器 ============ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 回读容器 -->
            <Border Background="White" CornerRadius="8" Padding="16"
                    Effect="{StaticResource EffectShadow2}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PD 回读 (ADC)" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="pd_id" Style="{StaticResource FieldLabel}" Margin="12,0,6,0"/>
                            <ComboBox Width="64" Height="28" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding PdIds}"
                                      SelectedItem="{Binding PdId}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="间隔(ms)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="62" Height="28" VerticalContentAlignment="Center"
                                     Text="{Binding MonitorIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanOperate}"/>
                            <Button Content="{Binding MonitorButtonText}" Width="120" Height="28" Margin="8,0,0,0"
                                    Command="{Binding ToggleMonitorCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 数值容器：大字读数 + 状态 + 原文 -->
                    <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#E3E9F2" BorderThickness="1"
                            CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PdValue}" FontSize="42" FontWeight="Bold"
                                               Foreground="#1B2A41" FontFamily="Consolas" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding PdUnit}" FontSize="16" Foreground="#7A8699"
                                               Margin="8,0,0,7" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PdContext}" FontSize="11" Foreground="#8A94A6" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border CornerRadius="12" Padding="12,5" HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EDEDED"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PdOk}" Value="True">
                                                    <Setter Property="Background" Value="#E6F7EC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PdStateText}" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#777"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PdOk}" Value="True">
                                                        <Setter Property="Foreground" Value="#1E8E4E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding PdRaw}" FontSize="11" Foreground="#9AA4B2"
                                           FontFamily="Consolas" Margin="0,8,0,0" MaxWidth="240"
                                           TextWrapping="Wrap" TextAlignment="Right"
                                           ToolTip="主控板应答原文，协议联调时核对用"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="⚡ 采集一次" Style="{StaticResource ButtonPrimary}"
                                Width="110" Height="34" FontWeight="Bold"
                                Command="{Binding ReadPdCommand}"/>
                        <Button Content="清空记录" Width="86" Height="34" Margin="8,0,0,0"
                                Command="{Binding ClearSamplesCommand}"/>
                        <TextBlock Text="指令：SMSCH / GPDADC（已确认）" FontSize="11" Foreground="#AAA"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 采集记录容器 -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16"
                    Effect="{StaticResource EffectShadow2}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="采集记录" FontWeight="Bold" FontSize="14" Foreground="#333"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#999"
                                   Text="{Binding Samples.Count, StringFormat=共 {0} 条（最多保留 500 条）}"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Samples}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent" CanUserAddRows="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="46" Binding="{Binding Index}"/>
                            <DataGridTextColumn Header="时间" Width="100" Binding="{Binding Time}"/>
                            <DataGridTextColumn Header="PD" Width="64" Binding="{Binding PdId}"/>
                            <DataGridTextColumn Header="光开关" Width="120" Binding="{Binding Mems}"/>
                            <DataGridTextColumn Header="ADC" Width="96" Binding="{Binding AdcText}"/>
                            <DataGridTextColumn Header="状态" Width="64" Binding="{Binding State}"/>
                            <DataGridTextColumn Header="应答原文" Width="*" Binding="{Binding Raw}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
